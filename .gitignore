# Gradle and build artifacts
.gradle/
build/
out/
bin/
classes/
run/
target/
*.class

# IDE/editor files
.idea/
.vscode/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/

# Forge / local runtime data
logs/
crash-reports/
screenshots/
saves/
usercache/
local.properties

# Generated or temporary files
*.log
*.log.*
*.tmp
*.bak
*.orig

# Project-specific generated artifacts
build-*.log
build-*.txt
full-build*.log
full-build*.txt
build_output*.log
build_result*.log
